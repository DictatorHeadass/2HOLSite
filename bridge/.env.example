# Your TikTok handle (with or without the @)
TIKTOK_USERNAME=your_handle

# Your deployed site's webhook endpoint
WEBHOOK_URL=https://your-site.vercel.app/api/tiktok/gift

# Shared secret — must EXACTLY match TIKTOK_WEBHOOK_SECRET in your Vercel env vars.
# Use a long random string. If you leave the site's secret unset, leave this blank too.
TIKTOK_WEBHOOK_SECRET=

# Optional: how often (ms) to retry connecting while you're not live. Default 30s.
# RETRY_MS=30000
